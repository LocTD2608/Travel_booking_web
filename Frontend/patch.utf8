+
+// ΓöÇΓöÇΓöÇ Detail APIs ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+export async function fetchHotelDetail(id: string | number): Promise<{ success: boolean; data: HotelDetailResult }> {
+    const url = `${BASE_URL}/hotels/${id}`;
+    const res = await fetch(url);
+    if (!res.ok) throw new Error(`Lß╗ùi ${res.status}: ${res.statusText}`);
+    return res.json();
+}
+
+export async function fetchFlightDetail(id: string | number): Promise<FlightDetailResult> {
+    const url = `${BASE_URL}/flights/${id}`;
+    const res = await fetch(url);
+    if (!res.ok) throw new Error(`Lß╗ùi ${res.status}: ${res.statusText}`);
+    return res.json();
+}
