+const { setHold } = require("../services/reservation.service");
 
 exports.getFlightDetail = async (req, res) => {
   try {
@@ -35,4 +36,26 @@ exports.getFlightDetail = async (req, res) => {
   } catch (err) {
     res.status(500).json({ error: err.message });
   }
+};
+
+exports.holdSeat = async (req, res) => {
+  try {
+    const { id } = req.params;
+    const { userId } = req.body;
+
+    if (!userId) {
+      return res.status(400).json({ message: "userId is required to hold seat" });
+    }
+
+    // Set hold in Redis for 10 minutes (600 seconds)
+    const holdKey = await setHold("flight", id, userId, 600);
+
+    res.json({
+      message: "Flight seat held for 10 minutes",
+      holdKey,
+      expiresInSeconds: 600
+    });
+  } catch (err) {
+    res.status(500).json({ error: err.message });
+  }
 };
